# Copier ce fichier en .env puis remplir les deux valeurs ci-dessous.
# .env est ignore par git (voir .gitignore) : ne jamais y mettre de vraies
# valeurs dans un fichier commite.

# Genere avec : python scripts/generate_password_hash.py
ACHIEVEMENTS_PASSWORD_HASH=

# Genere avec : python -c "import secrets; print(secrets.token_hex(32))"
ACHIEVEMENTS_SECRET_KEY=
