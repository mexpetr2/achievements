<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Playnite 10 tourne sur .NET Framework 4.6.2 : l'extension doit cibler
         la meme plateforme, sinon elle ne se charge pas. -->
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>AchievementsExporter</AssemblyName>
    <RootNamespace>AchievementsExporter</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permet de compiler net462 avec le seul SDK .NET, sans Visual Studio
         ni targeting pack installe sur la machine. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Playnite fournit deja le SDK a l'execution : on compile contre le sien
         (Private=false pour ne pas le recopier dans la sortie). -->
    <Reference Include="Playnite.SDK">
      <HintPath Condition="'$(PlayniteSdkPath)' == ''">$(LOCALAPPDATA)\Playnite\Playnite.SDK.dll</HintPath>
      <HintPath Condition="'$(PlayniteSdkPath)' != ''">$(PlayniteSdkPath)</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Fenetre de reglages : construite en code, sans XAML, pour rester
         compilable sans les cibles WPF de Visual Studio. -->
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

</Project>
